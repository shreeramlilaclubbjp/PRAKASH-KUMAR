{
  "entities": {
    "Movie": {
      "title": "Movie or Series",
      "description": "Represents a movie or a series in the catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnail": { "type": "string" },
        "youtubeId": { "type": "string" },
        "instagramId": { "type": "string" },
        "category": { "type": "string", "enum": ["movie", "series"] },
        "genre": { "type": "array", "items": { "type": "string" } },
        "rating": { "type": "number" },
        "releaseDate": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "seasons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "number": { "type": "number" },
              "title": { "type": "string" },
              "trailerId": { "type": "string" },
              "episodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "thumbnail": { "type": "string" },
                    "youtubeId": { "type": "string" },
                    "instagramId": { "type": "string" },
                    "duration": { "type": "string" },
                    "description": { "type": "string" },
                    "cast": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      },
      "required": ["id", "title", "category", "thumbnail"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user preferences and history.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "favorites": { "type": "array", "items": { "type": "string" } },
        "watchlist": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "thumbnail": { "type": "string" },
              "youtubeId": { "type": "string" },
              "category": { "type": "string" },
              "genre": { "type": "array", "items": { "type": "string" } },
              "rating": { "type": "number" },
              "releaseDate": { "type": "string" }
            }
          }
        },
        "watchHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "movieId": { "type": "string" },
              "timestamp": { "type": "number" }
            }
          }
        }
      },
      "required": ["uid", "favorites", "watchHistory"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document."
    }
  }
}
